# Copy to .env for local development. All values are optional.

APP_NAME=Ledger
CURRENCY_SYMBOL=$

# Leave blank to use SQLite (./data/ledger.db locally, /home/data on Azure).
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@host.postgres.database.azure.com:5432/ledger?sslmode=require
DATABASE_URL=

# Create six starter categories the first time the database is empty.
SEED_ON_FIRST_RUN=true
